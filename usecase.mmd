flowchart LR
    %% Actors (left / right) and UML-like system boundary
    Farmer([👤 Farmer])
    Manager([👤 Farm Manager])
    Admin([👤 System Admin])
    Gemini[<<External Service>>\nGemini API]
    Weather[<<External Service>>\nWeather Provider]
    Market[<<External Source>>\nMarket Price Source]

    subgraph PMS[Subsystem: Poultry Monitoring System]
      direction TB
      UC1((Manage Startup Plan))
      UC2((Enter Costs & Assumptions))
      UC3((Calculate KPIs))
      UC4((Generate Decision Charts))
      UC5((Get Weather Recommendation))
      UC6((Get Price Forecast))
      UC7((Show Your Decision Card))
      UC8((Analyze Existing Farm))
      UC9((Detect Disease from Image))
      UC10((Estimate Chicken Weight))
      UC11((Ask AI Chatbot))
      UC12((Switch Language AR/EN))
      UC13((Upload Media))
    end

    %% Main actor associations
    Farmer -->|association| UC1
    Farmer -->|association| UC8
    Farmer -->|association| UC9
    Farmer -->|association| UC10
    Farmer -->|association| UC11
    Farmer -->|association| UC12
    Farmer -->|association| UC13
    Manager -->|association| UC1
    Manager -->|association| UC8
    Admin -->|manages| UC12

    %% Include relations (UML style labels)
    UC1 -. <<include>> .-> UC2
    UC1 -. <<include>> .-> UC3
    UC1 -. <<include>> .-> UC4
    UC1 -. <<include>> .-> UC5
    UC1 -. <<include>> .-> UC6
    UC1 -. <<include>> .-> UC7

    %% External integrations
    UC5 -->|uses API| Weather
    UC6 -->|reads prices| Market
    UC11 -->|generate content| Gemini

    %% Styling to make it bigger / clearer like classic UML diagrams
    classDef actor fill:#ffffff,stroke:#111,stroke-width:1.5px,color:#111;
    classDef ext fill:#f8fafc,stroke:#334155,stroke-width:1.5px,color:#0f172a;
    classDef usecase fill:#ffffff,stroke:#111,stroke-width:1.2px,color:#111;

    class Farmer,Manager,Admin actor;
    class Gemini,Weather,Market ext;
    class UC1,UC2,UC3,UC4,UC5,UC6,UC7,UC8,UC9,UC10,UC11,UC12,UC13 usecase;
